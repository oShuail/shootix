# ==========================================================
#  SHOOTIX — environment
#  Copy to .env for local dev, and add the same keys in
#  Vercel → Project → Settings → Environment Variables.
# ==========================================================

# --- Supabase (required) ---------------------------------
# Dashboard → Project Settings → Data API  →  Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Dashboard → Project Settings → API Keys  →  service_role
# SECRET. Server-side only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Sessions --------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If omitted, a stable secret is derived from the service-role key.
SESSION_SECRET=

# --- First-run admin password ----------------------------
# Used only when the users table is empty. Change it after the
# first login (Admin panel → الإعدادات).
SHOOTIX_ADMIN_PASSWORD=change-me-now

# --- Storage buckets (optional; these are the defaults) ---
SUPABASE_GALLERY_BUCKET=shootix-gallery
SUPABASE_PRIVATE_BUCKET=shootix-private
